# Notification Service — local-dev / template (.env.example)
# Copy to .env.test (test VPS) or .env.production with real values.
# All secrets here use the CHANGE_ME convention (config-standardization P2) —
# never commit real keys (see memory `feedback_secret_injection_convention`).
#
# *** GAP FLAGGED (not fixed in this P2 lane — out of .env.example-authoring
# scope, needs a follow-up ticket) ***: this repo has NO application-prod.yaml.
# `application.yml` sets `spring.profiles.active: ${APP_PROFILE:dev}`, and
# spring.datasource / application.jwt.secret / application.cors are ONLY
# defined in application-dev.yaml. If APP_PROFILE=prod is set with no
# application-prod.yaml, Spring Boot loads NO profile-specific datasource/
# jwt/cors config at all — the vars below only take effect while the `dev`
# profile file is what's actually loaded (current real-world behavior on
# every environment, including test VPS/staging). Document reflects that
# reality; a dedicated application-prod.yaml (with no-default env-var
# bindings, matching apigatewayserv's pattern) is recommended fast-follow.

APP_PROFILE=dev
SERVER_PORT=9016

# Database (application-dev.yaml — see GAP note above)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teclavya_notifications
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Redis (application-dev.yaml — see GAP note above)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# SMTP — base application.yml (all profiles); log-only mode if left blank
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CHANGE_ME
SPRING_MAIL_PASSWORD=CHANGE_ME
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Internal service-to-service auth (cohorts-latest -> notification-service).
# NotificationController fails CLOSED (rejects all calls) if this is blank,
# so an unset value is safe but breaks the feature — set it explicitly.
INTERNAL_SERVICE_TOKEN=CHANGE_ME

# JWT (application-dev.yaml hardcodes a fallback hex secret today — see GAP
# note above; set explicitly for any real deployment)
APPLICATION_JWT_SECRET=CHANGE_ME

# CORS (application-dev.yaml hardcodes `application.cors`; Spring relaxed
# binding maps this to APPLICATION_CORS)
APPLICATION_CORS=http://127.0.0.1:3000,http://localhost:3000
